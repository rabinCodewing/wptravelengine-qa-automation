# ── WP Travel Engine QA Automation — environment ─────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# ── WordPress login (required) ───────────────────────────────────────────────
# The suite signs in once (npm run auth) and reuses the session.
WP_LOGIN_URL=http://your-site.local/wp-login.php
WP_USERNAME=admin
WP_PASSWORD=

# The site under test (front end / REST base). Used by the accommodation suite,
# the WPTE Doctor scanner and the runner UI.
FRONTEND_URL=http://your-site.local

# ── Accommodation add-on suite ───────────────────────────────────────────────
# License key for the Accommodation add-on (if the test site needs it).
ACCOMMODATION_LICENSE_KEY=
# Set to 1 to delete the QA trips/rooms the suite creates when it finishes.
ACCOMMODATION_CLEANUP=

# Stripe TEST keys — the accommodation checkout pays through WPTE's own Stripe
# add-on. Must be test keys (pk_test_/sk_test_); the test refuses live ones.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ── Security scan (npm run doctor, or the Security tab in npm run ui) ─────────
# A Subscriber/customer account on the site. The scan logs in with it to check
# what a low-permission user can reach. NEVER an administrator.
SECURITY_TEST_USER=
SECURITY_TEST_PASSWORD=

# ── Playwright run options (optional) ────────────────────────────────────────
# PW_HEADLESS=1          # run headless (default: headed, so runs are watchable)
# PW_SLOWMO=             # ms pad after each action (default 1000 headed, 0 headless)
# PW_LIVE_VIEW=1         # stream the browser into the runner UI
# PW_SMOOTH_SCROLL=1     # smooth-scroll during headed runs

# ── Runner UI (npm run ui) ───────────────────────────────────────────────────
# PORT=4417
# UI_PUBLIC_URL=         # external URL if the UI is reverse-proxied
# NO_SCHEDULE=1          # set on a SECOND copy of the runner so only one fires the schedule

# ── ReportPortal (optional) ──────────────────────────────────────────────────
# Reporting is added only when RP_API_KEY is set.
# RP_API_KEY=
# RP_ENDPOINT=
# RP_PROJECT=wptravelengine-qa
# RP_LAUNCH=WP Travel Engine QA Automation
# RP_LAUNCH_TITLE=
