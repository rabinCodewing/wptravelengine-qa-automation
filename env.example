# ─── PayLexer dashboard ──────────────────────────────────────────────────────
# Staging or live sign-in URL. The run's PayLexer must be the one the
# WordPress plugin on FRONTEND_URL is built for.
BASE_URL=https://app-staging.paylexer.com/signin
EMAIL=your_paylexer_dashboard_email@example.com
PASSWORD=your_paylexer_dashboard_password

# ─── WordPress site with WP Travel Engine + the PayLexer plugin ──────────────
FRONTEND_URL=https://your-test-site.example.com
WP_LOGIN_URL=https://your-test-site.example.com/wp-login.php?loggedout=true&wp_lang=en_US
WP_USERNAME=your_wp_admin_username
WP_PASSWORD=your_wp_admin_password

# ─── What one run does ───────────────────────────────────────────────────────
# Key in config/gatewayConfigs.js (case-sensitive). `npm run gateways` lists them.
PAYMENT_GATEWAY=Stripe
# This project automates WP Travel Engine only.
CURRENCY_PLATFORM=wte
# Optional: one of the gateway's own currencies instead of its defaultCurrency.
# RUN_CURRENCY=USD
# Optional: trips to book, in order (JSON array or comma list). Unset, the run
# books the first priced trip on /trip. A gateway's own `trip` wins.
# WTE_TRIPS=["Everest Base Camp Trek"]
# 1 = push the keys below into the gateway in PayLexer before the run.
# PAYLEXER_RECONFIGURE=1

# ─── Browser ─────────────────────────────────────────────────────────────────
# PW_HEADLESS=1
# PW_SLOWMO=0

# ─── ReportPortal (optional — active only when RP_API_KEY is set) ────────────
# RP_ENDPOINT=http://localhost:8080
# RP_PROJECT=paylexer-playwright
# RP_LAUNCH=WPTE PayLexer Automation
# RP_API_KEY=

# PayLexer test-gateways combined .env export
# Copy this file to `.env` (gitignored) and fill in TEST-MODE sandbox keys only.
# NEVER commit real credentials — this file (.env.example) contains placeholders only.
# A gateway's tiers SKIP (never fail) when its keys are absent, so you only need
# to fill in the gateways you're actively testing.

