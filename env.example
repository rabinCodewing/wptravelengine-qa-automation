# ── 0031-fatora ──────────────────────────────────────────────
# Sandbox credentials for the fatora gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways fatora
#
# ── Fatora ────────────────────────────────────────────────────────────────────
# Fatora keys are account GUIDs (no test/live prefix) — gate is presence-based.
# Fatora sends no webhooks (no Tier C). A sandbox key enables Tier B.
FATORA_API_KEY=your_fatora_api_key

# ── 0032-checkout-com ──────────────────────────────────────────────
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# Run:  pnpm test:gateways checkout-com
#
# Tier B (live sandbox one-time payment): CHECKOUT_SECRET_KEY
# Tier C (genuinely-signed webhook):      CHECKOUT_WEBHOOK_SECRET
#
# Get these from the Checkout.com Dashboard (sandbox):
#   Secret key  → Developers → API keys (sk_sbox_… or sk_test_…)
#   Public key  → Developers → API keys (pk_sbox_…) — not required by the tests
#   Webhook key → Developers → Webhooks → [your webhook] → Signature key
CHECKOUT_SECRET_KEY=sk_sbox_your_checkout_secret_key
CHECKOUT_PUBLIC_KEY=pk_sbox_your_checkout_public_key
CHECKOUT_PROCESSING_CHANNEL_ID=pc_your_checkout_processing_channel_id
# NAS accounts have a per-account API host. Copy the base URL shown in your
# sandbox dashboard, e.g. https://s2xc6vcy.api.sandbox.checkout.com
# Leave blank only if your account uses the shared https://api.sandbox.checkout.com host.
CHECKOUT_API_BASE_URL=https://your-subdomain.api.sandbox.checkout.com/

# ── 0033-culqi ──────────────────────────────────────────────
# Sandbox credentials for the culqi gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways culqi
#
# ── Culqi ─────────────────────────────────────────────────────────────────────
# Tier B: secret key — sk_test_ prefix required. Public key drives browser tokenization.
# Webhooks are unsigned (no Tier C).
CULQI_SECRET_KEY=sk_test_your_culqi_secret_key
CULQI_PUBLIC_KEY=pk_test_your_culqi_public_key

# ── 0034-pin-payments ──────────────────────────────────────────────
PIN_PAYMENTS_SECRET_KEY=your_pin_payments_secret_key
PIN_PAYMENTS_PUBLISHABLE_KEY=pk_your_pin_payments_publishable_key
PIN_PAYMENTS_WEBHOOK_SECRET=

# ── 0035-squad ──────────────────────────────────────────────
# Sandbox credentials for the squad gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways squad
#
# ── Squad (GTCO — Nigeria) ────────────────────────────────────────────────────
# Tier B + C: secret key — sandbox_sk_ prefix required.
# Same secret key signs webhooks (HMAC-SHA512, header x-squad-encrypted-body) —
# there is no separate webhook secret.
SQUAD_SECRET_KEY=sandbox_sk_your_squad_secret_key

# ── 0036-iyzico ──────────────────────────────────────────────
# Sandbox credentials for the iyzico gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways iyzico
#
# ── Iyzico (Turkey) ────────────────────────────────────────────────────────────
# Tier B + C: apiKey + secretKey — both require the sandbox- prefix.
# The same secretKey signs webhooks (HMAC-SHA256, header x-iyz-signature-v3)
# unless a dedicated webhookSecret is configured — iyzico's signature feature
# must be enabled by emailing entegrasyon@iyzico.com.
IYZICO_API_KEY=sandbox-your_iyzico_api_key
IYZICO_SECRET_KEY=sandbox-your_iyzico_secret_key
IYZICO_WEBHOOK_SECRET=sandbox-your_iyzico_webhook_secret

# ── 0037-payhere ──────────────────────────────────────────────
# Sandbox credentials for the payhere gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways payhere
#
# ── PayHere (Sri Lanka) ────────────────────────────────────────────────────────
# Tier B + C: merchantId + merchantSecret (form-POST checkout; merchantSecret
# also signs webhooks — MD5, nested pre-hash, signed in the POST body's md5sig
# field, not a header).
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
# Additionally required for refund + subscription-management tests (separate
# OAuth2 App credentials — basic checkout works without these).
PAYHERE_APP_ID=your_payhere_app_id
PAYHERE_APP_SECRET=your_payhere_app_secret

# ── 0038-myfatoorah ──────────────────────────────────────────────
# Sandbox credentials for the myfatoorah gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways myfatoorah
#
# ── MyFatoorah (GCC) ───────────────────────────────────────────────────────────
# Tier B: apiKey only.
MYFATOORAH_API_KEY=your_myfatoorah_api_key
# Tier C: separate portal-configured webhook secret (Integration Settings →
# Webhook Settings in the MyFatoorah portal — not settable via API).
MYFATOORAH_WEBHOOK_SECRET=your_myfatoorah_webhook_secret

# ── 0039-conekta ──────────────────────────────────────────────
# Sandbox credentials for the conekta gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in TEST-MODE keys only.
# A gateway's live tiers SKIP (never fail) when its keys are absent.
# Run:  pnpm test:gateways conekta
#
# ── Conekta (Mexico) ───────────────────────────────────────────────────────────
# Tier B: private key (key_… test key) + public key.
CONEKTA_API_KEY=key_your_conekta_api_key
CONEKTA_PUBLIC_KEY=key_your_conekta_public_key
CONEKTA_WEBHOOK_SECRET=your_conekta_webhook_public_key
# No webhook-secret var here: Conekta signs webhooks with RSA-SHA256 against a
# public key it alone controls the matching private key for, so a real signed
# webhook can't be self-produced in this suite. The signature-verification test
# instead generates its own RSA keypair and self-signs, proving the connector's
# verify() code path (not a live Conekta credential) — see the spec.

# ── 0040-openpay ──────────────────────────────────────────────
# Openpay MEXICO sandbox credentials (test-mode only — never production keys).
# Account: sandbox-dashboard.openpay.mx
OPENPAY_MERCHANT_ID=your_openpay_merchant_id
OPENPAY_PRIVATE_KEY=sk_your_openpay_private_key
OPENPAY_PUBLIC_KEY=pk_your_openpay_public_key
OPENPAY_REGION=mx

# ── 0041-nets ──────────────────────────────────────────────
# Sandbox credentials for the Nets / Nexi Checkout gateway acceptance suite.
# Copy this file to `.env` (gitignored) in this folder and fill in a TEST-MODE key only.
# The live tier SKIPS (never fails) when the key is absent.
# Run:  pnpm test:gateways nets
#
# ── Nets / Nexi Checkout ──────────────────────────────────────────────────────
# A SINGLE secret key (Payment API auth + the derived webhook token). No checkout
# key, no webhook secret. Nets test keys are 32-hex with no test/live prefix
# (the account/host decides mode), so the gate is presence-based. A sandbox key
# enables Tier B; the webhook token is derived from it (no separate Tier C).
NETS_SECRET_KEY=your_nets_secret_key

# ── 0042-mercadopago ──────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=TEST-your_mercadopago_public_key
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=BRL

# ── 0043-payu ──────────────────────────────────────────────
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# ── 0044-global-payments ──────────────────────────────────────────────
GLOBAL_PAYMENTS_APP_ID=your_global_payments_app_id
GLOBAL_PAYMENTS_APP_KEY=your_global_payments_app_key

# ── 0045-fastspring ──────────────────────────────────────────────
FASTSPRING_API_USERNAME=your_fastspring_api_username
FASTSPRING_API_PASSWORD=your_fastspring_api_password
# Storefront subdomain, e.g. yourstore.test.onfastspring.com
FASTSPRING_STORE_ID=your_fastspring_store_id
# Popup checkout path SUFFIX after "popup-" (e.g. "paylexer" for popup-paylexer).
FASTSPRING_POPUP_PATH=your_fastspring_popup_path
# Webhook HMAC-SHA256 secret set on the FastSpring webhook endpoint (Tier C).
FASTSPRING_WEBHOOK_SECRET=

DODO_API_KEY=your_dodo_api_key
DODO_PUBLISHABLE_KEY=your_dodo_publishable_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret

KHALTI_SECRET_KEY=

# Getnet
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=

# Braintree
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Tpay
TPAY_CLIENT_ID=your_tpay_client_id
TPAY_CLIENT_SECRET=your_tpay_client_secret
TPAY_WEBHOOK_SECRET=your_tpay_webhook_secret

# Komoju
KOMOJU_SECRET_KEY=your_komoju_secret_key
KOMOJU_WEBHOOK_SECRET=your_komoju_webhook_secret

# Datatrans
DATATRANS_MERCHANT_ID=your_datatrans_merchant_id
DATATRANS_PASSWORD=your_datatrans_password
DATATRANS_HMAC_KEY=your_datatrans_hmac_key

# Cost+
COSTPLUS_API_KEY=your_costplus_api_key

# Paytrail
PAYTRAIL_MERCHANT_ID=your_paytrail_merchant_id
PAYTRAIL_SECRET_KEY=your_paytrail_secret_key

# Finix
# The merchant id field takes the username and password joined by a colon
# (username:password) — that is what the Finix dashboard hands you.
FINIX_USERNAME=your_finix_username
FINIX_PASSWORD=your_finix_password
FINIX_MERCHANT_ID=your_finix_username:your_finix_password

# ── fonepay ──────────────────────────────────────────────
FONEPAY_USERNAME=your_fonepay_username
FONEPAY_PASSWORD=your_fonepay_password
# 16-digit terminal id from the Fonepay merchant portal.
FONEPAY_TERMINAL_ID=your_fonepay_terminal_id
# Base64 PKCS#8 body only — no BEGIN/END armour, no newlines, all on one line.
FONEPAY_RSA_PRIVATE_KEY=

# ── multisafepay ──────────────────────────────────────────────
# Site API key from the MultiSafepay dashboard (Settings → Website settings).
MULTISAFEPAY_API_KEY=your_multisafepay_api_key
# Checkout overrides — all optional, defaults in gatewayPaymentForms.js.
# METHOD is the label in the hosted page's method list ("Visa", "Mastercard").
MULTISAFEPAY_TEST_METHOD=Visa
MULTISAFEPAY_TEST_CARD_NUMBER=4111111111111111
MULTISAFEPAY_TEST_CARD_CVC=123
MULTISAFEPAY_TEST_CARD_HOLDER=Token Tutorial

# ── pesapal ──────────────────────────────────────────────
# Sandbox consumer key/secret from the Pesapal dashboard (Settings → API Keys).
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
# Base64 value ending in "=" — keep it verbatim, no quotes, no trimming.
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
# UUID returned when the key/secret pair is registered against a callback URL;
# PayLexer's "Get IPN ID" button produces it. Set it to replay a known id
# instead of re-registering on every run.
PESAPAL_IPN_ID=your_pesapal_ipn_id
# Checkout overrides — all optional, defaults in gatewayPaymentForms.js.
# Only a card from Pesapal's own test list is approved (the iframe links it as
# "a list of test card details"). Defaults to the sandbox Visa from the
# "No Authorization" row; 4000000000001091 is the 3-D Secure one and
# 4000000000001018 always declines.
# Settle time after the redirect to cybqa.pesapal.com before the first
# click, in ms (default 5000). Raise it if the card panel fails to open.
PESAPAL_REDIRECT_SETTLE_MS=5000
PESAPAL_TEST_CARD_NUMBER=4761739001010010
PESAPAL_TEST_CARD_CVC=123
# Those cards are published with a FIXED 07/28 expiry — any other expiry is
# declined, so this gateway does not follow the house 02/current+3 convention.
PESAPAL_TEST_EXPIRY_MONTH=07
PESAPAL_TEST_EXPIRY_YEAR=2028
PESAPAL_TEST_FIRST_NAME=Token
PESAPAL_TEST_LAST_NAME=Tutorial
PESAPAL_TEST_EMAIL=test@example.com
# ISO-3166 alpha-2 — it is the <option value>, not the country name. Countries
# with a region list (US, CA, …) then render the state select, which
# PESAPAL_TEST_STATE fills.
PESAPAL_TEST_COUNTRY=US
PESAPAL_TEST_STATE=CA
# Without the dialling code — Pesapal sets that from the country.
PESAPAL_TEST_PHONE=6505551234
PESAPAL_TEST_ADDRESS=1600 Amphitheatre Parkway
PESAPAL_TEST_CITY=Mountain View
PESAPAL_TEST_POSTAL_CODE=94043

# ── niubiz ──────────────────────────────────────────────
NIUBIZ_API_USERNAME=your_niubiz_api_username
NIUBIZ_API_PASSWORD=your_niubiz_api_password
NIUBIZ_MERCHANT_ID=your_niubiz_merchant_id
# Niubiz SANDBOX test card for the hosted checkout flow (fillCardDetails).
# A generic 4111... card will NOT authorize on Niubiz -- use the number,
# expiry and CVV Niubiz publishes for your sandbox. Defaults are placeholders.
NIUBIZ_TEST_CARD_NUMBER=your_niubiz_sandbox_card_number
NIUBIZ_TEST_EXPIRY_MONTH=12
NIUBIZ_TEST_EXPIRY_YEAR=29
NIUBIZ_TEST_CARD_CVC=123
NIUBIZ_TEST_FIRST_NAME=Token
NIUBIZ_TEST_LAST_NAME=Tutorial
NIUBIZ_TEST_EMAIL=test@example.com
NIUBIZ_TEST_CITY=Lima
NIUBIZ_TEST_COUNTRY=Peru

# ── barion ──────────────────────────────────────────────
# The ONLY credential Barion takes (config/gatewayConfigs.js lists one field,
# POSKey), read as BARION_POSKEY by GatewayConfigurationPage.fillCredentials().
# From the Barion SANDBOX shop: https://secure.test.barion.com -> Shops -> your
# shop -> POSKey. The sandbox and production keys are different; a production
# key against secure.test.barion.com is rejected the same way a missing one is.
#
# Without it fillCredentials() logs "BARION_POSKEY not found in .env" and moves
# on, leaving whatever key PayLexer already had. The run then gets all the way
# to Confirm Booking before Barion refuses to open a payment session, and the
# checkout shows "Session Error / Authentication required" with no redirect.
BARION_POSKEY=your_barion_sandbox_poskey

# ── shift4 ──────────────────────────────────────────────
# Test-mode keys from the Shift4 dashboard. Read as SHIFT4_PUBLIC_KEY /
# SHIFT4_SECRET_KEY by GatewayConfigurationPage.fillCredentials().
SHIFT4_PUBLIC_KEY=pk_test_your_shift4_public_key
SHIFT4_SECRET_KEY=sk_test_your_shift4_secret_key
# Hosted-checkout test data for config/gatewayPaymentForms.js > Shift4.
# All optional — the defaults below are what the handler falls back to.
SHIFT4_TEST_CARD_NUMBER=4242424242424242
SHIFT4_TEST_CARD_CVC=123
SHIFT4_TEST_CARD_HOLDER=Token Tutorial
SHIFT4_TEST_EMAIL=test@example.com

# ---- Slack: test results from the add-on runner (npm run ui) ----
# Easier: set these on the runner's Settings page (saved to data/slack.json,
# which wins over .env). Either a bot (can post failure screenshots) ...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123ABCD
# ... or an incoming webhook (text only):
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# When to post automatically: every | failures | changes | off
# SLACK_NOTIFY_ON=every
# Public address of the runner, for the "Open the runner" link in Slack.
# Leave unset when it only runs on this machine.
# UI_PUBLIC_URL=
# Set to 1 on a SECOND copy of the runner (another PORT, same folder) so only
# one copy fires the scheduled run.
# NO_SCHEDULE=1
