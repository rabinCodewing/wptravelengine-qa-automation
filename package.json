{
  "name": "wpte-test-automation",
  "version": "1.0.0",
  "description": "Playwright automation for PayLexer payment gateways on WP Travel Engine: PayLexer dashboard, PayLexer WordPress plugin, WPTE gateway settings, currency and checkout.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "npm install && npx playwright install firefox",
    "auth": "playwright test tests/login.setup.js --project=setup",
    "test": "playwright test tests/wpGatewayCheckout.spec.js --project=firefox",
    "test:wp": "playwright test tests/wpGatewayCheckout.spec.js --project=firefox",
    "test:gateway": "playwright test tests/paymentGateway.spec.js --project=firefox",
    "test:login": "playwright test tests/login.spec.js --project=firefox",
    "test:all": "node scripts/runGateways.js",
    "gateways": "node scripts/runGateways.js --list",
    "report": "playwright show-report",
    "test:accommodation": "playwright test tests/accommodation.spec.js --project=firefox",
    "ui:accommodation": "node scripts/addonsUi.js",
    "ui": "node scripts/addonsUi.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@reportportal/agent-js-playwright": "^5.5.0",
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
