{
  "name": "wpte-test-automation",
  "version": "1.0.0",
  "description": "Playwright QA automation and security testing for WP Travel Engine: add-on suites (Accommodation), the WPTE Doctor security scanner, and the add-on runner UI.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "npm install && npx playwright install firefox",
    "auth": "playwright test tests/login.setup.js --project=setup",
    "test:accommodation": "playwright test tests/accommodation.spec.js --project=firefox",
    "ui": "node scripts/addonsUi.js",
    "ui:accommodation": "node scripts/addonsUi.js",
    "doctor": "node scripts/doctor.js",
    "report": "playwright show-report",
    "qa-report": "node scripts/qaReport.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@reportportal/agent-js-playwright": "^5.5.0",
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
